{% extends "base.twig" %}

{% set page_title = portfolio.name %}
{% set subPageDescription = portfolio.description|striptags|slice(0, 160) %}
{% set og_url = routes.portfolio ~ "/" ~ portfolio.id %}
{% set basicIMG = portfolio.image %}
{% set page_type = "article" %}
{% set nav_active = "portfolio" %}

{% block content %}

  <div class="container">
    <div class="breadcrumb">
      <a href="{{ siteUrl }}">{{ lang.home }}</a>
      <span class="sep">/</span>
      <a href="{{ siteUrl }}{{ routes.portfolio }}">{{ lang.portfolio|default('أعمالنا') }}</a>
      <span class="sep">/</span>
      <span class="current">{{ portfolio.name }}</span>
    </div>

    <!-- ===== WORK HEAD ===== -->
    <div class="article-head">
      {% if portfolio.category %}<span class="cat-tag">{{ portfolio.category }}</span>{% endif %}
      <h1>{{ portfolio.name }}</h1>
      <div class="article-meta">
        <div class="avatar">{{ siteName|slice(0,2) }}</div>
        <span>{{ siteName }}</span>
        {% if portfolio.completion_date %}<span class="sep">•</span><span>{{ portfolio.completion_date|date('d/m/Y') }}</span>{% endif %}
      </div>
    </div>

    {% if portfolio.image %}
    <div class="article-image">
      <img src="{{ portfolio.image }}" alt="{{ portfolio.name }}" loading="lazy">
    </div>
    {% endif %}

    <!-- ===== WORK BODY ===== -->
    <article class="article-body">
      {{ portfolio.description|raw }}
    </article>

    {% if portfolio.demo %}
    <div style="max-width:720px;margin:0 auto 32px;text-align:center;">
      <a href="{{ portfolio.demo }}" target="_blank" rel="noopener" class="btn btn-primary">{{ currentLang == 'en' ? "View live project" : "معاينة المشروع" }}</a>
    </div>
    {% endif %}

    <div class="share-row" style="max-width:720px;margin-inline:auto;">
      <span class="label">{{ lang.share|default('شارك:') }}</span>
      <a class="social-btn" href="https://x.com/intent/tweet?url={{ portfolio.url }}&text={{ portfolio.name }}" target="_blank" rel="noopener" aria-label="X">
        <svg viewBox="0 0 24 24"><line x1="4" y1="4" x2="20" y2="20"/><line x1="20" y1="4" x2="4" y2="20"/></svg>
      </a>
      <a class="social-btn" href="https://www.linkedin.com/sharing/share-offsite/?url={{ portfolio.url }}" target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="4"/><line x1="7" y1="10" x2="7" y2="17"/><circle cx="7" cy="6.6" r="0.6"/><path d="M11 17v-4.5a2 2 0 0 1 4 0V17"/><line x1="11" y1="10" x2="11" y2="17"/></svg>
      </a>
      <a class="social-btn" href="https://wa.me/?text={{ portfolio.name }}%20{{ portfolio.url }}" target="_blank" rel="noopener" aria-label="WhatsApp">
        <svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-8.4 8.4 8.3 8.3 0 0 1-3.9-.95L3 21l2.1-5.6a8.3 8.3 0 0 1-.95-3.9A8.4 8.4 0 0 1 12.6 3a8.4 8.4 0 0 1 8.4 8.5z"/></svg>
      </a>
    </div>
  </div>

  {% if other_portfolios is defined and other_portfolios|length > 0 %}
  <!-- ===== OTHER WORK ===== -->
  <div class="related-wrap">
    <div class="container">
      <div class="related-head">
        <div class="eyebrow"><span class="dot"></span> {{ lang.portfolio|default('أعمالنا') }}</div>
        <h2>{{ currentLang == 'en' ? "More work" : "أعمال أخرى" }}</h2>
      </div>
      <div class="blog-grid">
        {% for op in other_portfolios %}
        <a class="blog-card" href="{{ op.url }}">
          <div class="thumb">
            {% if op.image %}<img src="{{ siteUrl }}files/portfolio/{{ op.image }}" alt="{{ op.name }}" loading="lazy">{% else %}
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            {% endif %}
          </div>
          <div class="body">
            <h3>{{ op.name }}</h3>
          </div>
        </a>
        {% endfor %}
      </div>
    </div>
  </div>
  {% endif %}

{% endblock %}
