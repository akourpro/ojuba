{% extends "base.twig" %}

{% set page_title = error_message|default(lang.page_not_found) %}

{% block content %}
<section style="padding:120px 0;">
    <div class="container" style="text-align:center;">
        <div style="font-size:clamp(60px,10vw,120px);font-weight:900;background:linear-gradient(135deg,var(--primary),var(--primary-deep));-webkit-background-clip:text;background-clip:text;color:transparent;line-height:1;">{{ error_type|default('404') }}</div>
        <h2 style="font-size:clamp(22px,3vw,30px);margin:20px 0 10px;">{{ error_message|default(lang.page_not_found) }}</h2>
        <p style="color:var(--muted);max-width:480px;margin:0 auto 30px;font-weight:600;">{{ error_description|default(lang.page_not_found_desc) }}</p>
        <a href="{{ siteUrl }}" class="btn btn-primary">{{ lang.back_to_home }}</a>
    </div>
</section>
{% endblock %}
