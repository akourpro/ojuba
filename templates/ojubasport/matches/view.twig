{% extends "base.twig" %}

{% set page_title = match.team_home ~ ' × ' ~ match.team_away %}
{% set subPageDescription = currentLang == 'en' ? (match.team_home ~ ' vs ' ~ match.team_away ~ (match.competition ? ' — ' ~ match.competition : '')) : (match.team_home ~ ' × ' ~ match.team_away ~ (match.competition ? ' — ' ~ match.competition : '')) %}
{% set og_url = routes.matches ~ "/" ~ match.id %}

{% block content %}

  <div class="container">
    <div class="breadcrumb">
      <a href="{{ siteUrl }}">{{ lang.home }}</a>
      <span class="sep">/</span>
      <a href="{{ siteUrl }}{{ routes.matches }}">{{ currentLang == 'en' ? 'Matches' : 'المباريات' }}</a>
      <span class="sep">/</span>
      <span class="current">{{ match.team_home }} × {{ match.team_away }}</span>
    </div>

    <!-- ===== MATCH DETAIL (نفس أسلوب spotlight-match بالرئيسية، بحجم أكبر) ===== -->
    <div class="match-detail-wrap">
      <div class="spotlight-match match-detail-card match-status-{{ match.match_status }}">
        <div class="match-top">
          {% if match.competition %}<span class="match-competition">{{ match.competition }}</span>{% endif %}
          {% if match.match_status == 'live' %}
          <span class="match-badge live">{{ currentLang == 'en' ? 'Live Now' : 'مباشر الآن' }}</span>
          {% elseif match.match_status == 'finished' %}
          <span class="match-badge finished">{{ currentLang == 'en' ? 'Finished' : 'انتهت' }}</span>
          {% else %}
          <span class="match-badge upcoming">{{ match.date_human }}</span>
          {% endif %}
        </div>
        <div class="spotlight-teams">
          <div class="spotlight-team">
            {% if match.team_home_logo %}<img src="{{ match.team_home_logo }}" alt="{{ match.team_home }}" loading="lazy">{% endif %}
            <span>{{ match.team_home }}</span>
          </div>
          <div class="spotlight-center">
            {% if match.match_status == 'upcoming' %}
            <span class="spotlight-vs">VS</span>
            <span class="spotlight-time">{{ match.date_human }}</span>
            {% else %}
            <span class="spotlight-score">{{ match.score_home }} - {{ match.score_away }}</span>
            {% endif %}
          </div>
          <div class="spotlight-team">
            {% if match.team_away_logo %}<img src="{{ match.team_away_logo }}" alt="{{ match.team_away }}" loading="lazy">{% endif %}
            <span>{{ match.team_away }}</span>
          </div>
        </div>
        {% if match.venue or match.broadcast_channel %}
        <div class="match-foot">
          {% if match.venue %}<span class="match-venue"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>{{ match.venue }}</span>{% endif %}
          {% if match.broadcast_channel %}<span class="match-broadcast"><svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><polygon points="10 10 15 12.5 10 15"/></svg>{{ match.broadcast_channel }}</span>{% endif %}
        </div>
        {% endif %}
      </div>

      {% if moduleEnabled('standings') %}
      <p class="match-detail-cta"><a href="{{ siteUrl }}#standings" class="btn btn-ghost">{{ currentLang == 'en' ? 'View league standings' : 'عرض جدول الترتيب' }}</a></p>
      {% endif %}
    </div>

    {% if related_articles is defined and related_articles|length > 0 %}
    <!-- ===== أخبار مرتبطة بهذه المباراة (بحث عكسي عبر blogs.related_match_id) ===== -->
    <div class="related-head" style="margin-top:50px;">
      <div class="eyebrow"><span class="dot"></span> {{ currentLang == 'en' ? 'Related coverage' : 'تغطية متعلقة' }}</div>
      <h2>{{ currentLang == 'en' ? 'News about this match' : 'أخبار عن هذه المباراة' }}</h2>
    </div>
    <div class="blog-grid" style="margin-bottom:60px;">
      {% for post in related_articles %}
      <a class="blog-card" href="{{ post.url }}">
        <div class="thumb">
          {% if post.image %}<img src="{{ post.image }}" alt="{{ post.name }}" loading="lazy">{% else %}
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          {% endif %}
        </div>
        <div class="body">
          <h3>{{ post.name }}</h3>
        </div>
      </a>
      {% endfor %}
    </div>
    {% endif %}

  </div>

{% endblock %}
