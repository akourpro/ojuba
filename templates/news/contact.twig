{% extends "base.twig" %}

{% set page_title = lang.contact_us %}
{% set og_url = routes.contact %}

{% block content %}

  <section class="page-hero">
    <div class="container">
      <div class="eyebrow"><span class="dot" style="background:#fff;"></span> {{ lang.contact_us }}</div>
      <h1>{{ lang.contact_us }}</h1>
      <p>{{ lang.contact_me_anytime }}</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="contact-grid" style="margin-top:0;">
        <form class="contact-form" id="contactForm" method="POST" novalidate>
          <div style="position:absolute;left:-9999px;top:-9999px" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
          </div>

          <div class="form-row">
            <label for="fname">{{ lang.name }}</label>
            <input type="text" id="fname" name="fname" required>
          </div>
          <div class="form-row">
            <label for="lname">{{ lang.subject }}</label>
            <input type="text" id="lname" name="lname" required>
          </div>
          <div class="form-row">
            <label for="phone">{{ lang.phone }}</label>
            <input type="text" id="phone" name="phone" required>
          </div>
          <div class="form-row">
            <label for="email">{{ lang.email }}</label>
            <input type="email" id="email" name="email" required>
          </div>
          <div class="form-row">
            <label for="message">{{ lang.message }}</label>
            <textarea id="message" name="message" required></textarea>
          </div>
          <input type="hidden" name="_csrf" id="csrf" value="{{ csrftoken }}">
          <button type="button" id="sendMessage" class="btn btn-primary" style="width:100%;">{{ lang.send_message }}</button>
          <div id="msgSubmit" style="margin-top:12px"></div>
        </form>

        <div class="contact-info">
          {% if site_mail %}
          <div class="info-card">
            <div class="ic"><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4z" opacity="0"/><path d="M22 6l-10 7L2 6"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg></div>
            <div>
              <div class="label">{{ lang.email }}</div>
              <a class="value" href="mailto:{{ site_mail }}">{{ site_mail }}</a>
            </div>
          </div>
          {% endif %}
          {% if site_phone %}
          <div class="info-card">
            <div class="ic"><svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
            <div>
              <div class="label">{{ lang.phone }}</div>
              <a class="value" href="tel:{{ site_phone }}">{{ site_phone }}</a>
            </div>
          </div>
          {% endif %}
          {% if location %}
          <div class="info-card">
            <div class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
            <div>
              <div class="label">{{ lang.contact_information }}</div>
              <span class="value">{{ location }}</span>
            </div>
          </div>
          {% endif %}
          {% if whatsapp_number %}
          <div class="info-card">
            <div class="ic"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-8.4 8.4 8.3 8.3 0 0 1-3.9-.95L3 21l2.1-5.6a8.3 8.3 0 0 1-.95-3.9A8.4 8.4 0 0 1 12.6 3a8.4 8.4 0 0 1 8.4 8.5z"/></svg></div>
            <div>
              <div class="label">{{ lang.whatsapp }}</div>
              <a class="value" href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener">{{ whatsapp_number }}</a>
            </div>
          </div>
          {% endif %}
          {% if maps %}
          <div class="social-box" style="padding:0;overflow:hidden;">
            <iframe src="{{ maps }}" width="100%" height="220" style="border:0;display:block;border-radius:16px;" loading="lazy"></iframe>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <script src="js/contact.js"></script>
{% endblock %}
