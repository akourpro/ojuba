ErrorDocument 404 /errors/404.php
ErrorDocument 500 /errors/500.php
ErrorDocument 401 /errors/401.php
ErrorDocument 403 /errors/404.php

Options -Indexes -MultiViews +FollowSymlinks
CheckSpelling off

# auto include
<IfModule mod_php.c>
    php_value include_path "/Applications/XAMPP/htdocs/ojuba/"
    php_value auto_prepend_file autoload.php
    php_value auto_append_file none
</IfModule>
<IfModule mod_php7.c>
    php_value include_path "/Applications/XAMPP/htdocs/ojuba/"
    php_value auto_prepend_file autoload.php
    php_value auto_append_file none
</IfModule>
<IfModule mod_php8.c>
    php_value include_path "/Applications/XAMPP/htdocs/ojuba/"
    php_value auto_prepend_file autoload.php
    php_value auto_append_file none
</IfModule>

#Routes
RewriteEngine On

# home
DirectoryIndex home.php
RewriteRule ^dashboard/?$ home.php?lang= [QSA,L]
RewriteRule ^index/?$ home.php?lang= [QSA,L]
RewriteRule ^en/?$ home.php?lang=en [QSA,L]
RewriteRule ^ar/?$ home.php?lang=ar [QSA,L]


# Search
RewriteRule ^search/?$ search.php?lang= [QSA,L]
RewriteRule ^search/(.*)?$ search.php?search=$1&lang= [QSA,L]

# Contact
RewriteRule ^contact/?$ contact.php?lang= [QSA,L]

# Blogs
RewriteRule ^blog/?$ blogs/all.php?lang= [QSA,L]
RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blogs/view.php?slug=$1&lang= [QSA,L]

# Services
RewriteRule ^service/?$ services/all.php?lang= [QSA,L]
RewriteRule ^service/([a-zA-Z0-9-]+)/?$ services/view.php?slug=$1&lang= [QSA,L]

# Portfolio
RewriteRule ^portfolio/?$ portfolio/all.php?lang= [QSA,L]
RewriteRule ^portfolio/([0-9]+)/?$ portfolio/view.php?id=$1&lang= [QSA,L]
RewriteRule ^portfolio/([a-zA-Z0-9-]+)/?$ portfolio/view.php?slug=$1&lang= [QSA,L]

# Matches
RewriteRule ^matches/?$ matches/all.php?lang= [QSA,L]
RewriteRule ^matches/([0-9]+)/?$ matches/view.php?id=$1&lang= [QSA,L]

# Pages
RewriteRule ^page/([a-zA-Z0-9-]+)/?$ pages.php?slug=$1&lang= [QSA,L]

# END CUSTOM ROUTES

# Account (روابط بديلة ثابتة لصفحة التواصل — تعمل دائماً بجانب الرابط المخصص أعلاه)
RewriteRule ^contact-us/?$ contact.php?lang= [QSA,L]
RewriteRule ^contact_us/?$ contact.php?lang= [QSA,L]

# Blogs (رابط بديل ثابت)
RewriteRule ^blogs/?$ blogs/all.php?lang= [QSA,L]

# Services (رابط بديل ثابت)
RewriteRule ^services/?$ services/all.php?lang= [QSA,L]

# Portfolio (روابط بديلة ثابتة)
RewriteRule ^portfolios/?$ portfolio/all.php?lang= [QSA,L]

# Projects (نفسها Portfolio — رابط بديل ثابت)
RewriteRule ^project/?$ portfolio/all.php?lang= [QSA,L]
RewriteRule ^projects/?$ portfolio/all.php?lang= [QSA,L]
RewriteRule ^project/([0-9]+)/?$ portfolio/view.php?id=$1&lang= [QSA,L]
RewriteRule ^project/([a-zA-Z0-9-]+)/?$ portfolio/view.php?slug=$1&lang= [QSA,L]

# Matches (رابط بديل ثابت)
RewriteRule ^match/?$ matches/all.php?lang= [QSA,L]
RewriteRule ^match/([0-9]+)/?$ matches/view.php?id=$1&lang= [QSA,L]

# Pages (رابط بديل ثابت)
RewriteRule ^pages/([a-zA-Z0-9-]+)/?$ pages.php?slug=$1&lang= [QSA,L]

# Pricing (صفحة أسعار مستقلة)
RewriteRule ^pricing/?$ pricing.php?lang= [QSA,L]

# Previews
RewriteRule ^preview-post/?$ previews/blog.php?lang= [QSA,L] # معاينة المقالات
RewriteRule ^preview-page/?$ previews/page.php?lang= [QSA,L] # معاينة الصفحات
RewriteRule ^preview-portfolio/?$ previews/portfolio.php?lang= [QSA,L] # معاينة الأعمال
RewriteRule ^preview-service/?$ previews/service.php?lang= [QSA,L] # معاينة الخدمات
RewriteRule ^preview-home/?$ previews/home.php?lang= [QSA,L] # معاينة الرئيسية
RewriteRule ^preview-pricing/?$ previews/pricing.php?lang= [QSA,L] # معاينة صفحة الأسعار المستقلة

# sitemap
RewriteRule ^sitemap/?$ sitemap.php?lang= [QSA,L]
RewriteRule ^sitemap.xml/?$ sitemap.php?lang= [QSA,L]

# Feed/RSS
RewriteRule ^feed/?$ api/feed.php?lang= [QSA,L]
RewriteRule ^rss/?$ api/feed.php?lang= [QSA,L]
RewriteRule ^blogs.rss/?$ api/feed.php?lang= [QSA,L]

# robots
RewriteRule ^robots/?$ robots.php?lang= [QSA,L]
RewriteRule ^robots.txt/?$ robots.php?lang= [QSA,L]

#file without ext
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php
